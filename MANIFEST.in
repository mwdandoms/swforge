include LICENSE
include README.md
include README.en.md
include CHANGELOG.md
include CHANGELOG.en.md
include .gitignore
recursive-include docs *.md *.json *.log
recursive-include demo *.py
recursive-include examples *.py *.json
recursive-include tests *.py
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.SLDPRT *.SLDDRW *.SLDASM *.pdf